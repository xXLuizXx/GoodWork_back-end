# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=

# App
PORT=3333
API_URL=http://localhost:3333
STORAGE_URL=http://localhost:3333
APP_WEB_URL=http://localhost:3000

# Banco — local usa os padrões do docker-compose (DB_HOST, DB_PORT, DB_USER, DB_PASS, DB_NAME).
# Em produção (Neon): connection string completa + SSL
DATABASE_URL=
DATABASE_SSL=false

# SMTP — local: Mailtrap sandbox; produção: Brevo (smtp-relay.brevo.com, porta 2525)
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASS=
# Remetente; no Brevo deve ser um e-mail verificado em Senders
MAIL_FROM="GoodWork <seu-email@gmail.com>"

# Storage: "disk" (padrão, salva em tmp/) ou "cloudinary"
STORAGE_DRIVER=disk
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
